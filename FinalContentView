    // Logic to toggle between 2D and 3D camera states
    private func toggle3D() {
        withAnimation(.easeInOut(duration: 0.5)) {
            is3D.toggle()
            
            let center = locationManager.location?.coordinate ?? position.camera?.centerCoordinate ?? defaultCoordinate
            let distance = position.camera?.distance ?? 1300
            let targetPitch: Double = is3D ? 60 : 0
            
            position = .camera(
                MapCamera(centerCoordinate: center, distance: distance, heading: 0, pitch: targetPitch)
            )
        }
    }
    
    // Logic to center map back on user
    private func centerOnUser() {
        requestLocationAccess()
        withAnimation(.spring(response: 0.4, dampingFraction: 0.7)) {
            position = .userLocation(fallback: .region(MKCoordinateRegion(center: CLLocationCoordinate2D(latitude: 41.836, longitude: -87.648), span: MKCoordinateSpan(latitudeDelta: 0.02, longitudeDelta: 0.02))))
        }
    }
    
    private func refreshLocationAuthorization() {
        handleLocationAuthorization(locationManager.authorizationStatus, locationManager: locationManager)
    }

    private func handleLocationAuthorization(_ status: CLAuthorizationStatus, locationManager: CLLocationManager) {
        locationAuthorizationStatus = status
        switch status {
        case .notDetermined:
            locationPermissionAlertMessage = nil
        case .denied, .restricted:
            locationPermissionAlertMessage = "Location services not allowed for this app. Please change this in the settings app to use Mapscessible."
        case .authorizedAlways, .authorizedWhenInUse:
            locationPermissionAlertMessage = nil
        @unknown default:
            locationPermissionAlertMessage = "Location services not allowed for this app. Please change this in the settings app to use Mapscessible."
        }
    }

    private var shouldShowLocationRequestPage: Bool {
        switch locationAuthorizationStatus {
        case .authorizedAlways, .authorizedWhenInUse:
            return false
        case .notDetermined, .denied, .restricted:
            return true
        @unknown default:
            return true
        }
    }

    private func requestLocationAccess() {
        switch locationAuthorizationStatus {
        case .notDetermined:
            locationManager.requestWhenInUseAuthorization()
        case .denied, .restricted:
            locationPermissionAlertMessage = "Location services not allowed for this app. Please change this in the settings app to use Mapscessible."
        case .authorizedAlways, .authorizedWhenInUse:
            locationPermissionAlertMessage = nil
        @unknown default:
            locationPermissionAlertMessage = "Location services not allowed for this app. Please change this in the settings app to use Mapscessible."
        }
    }

    private func openSystemSettings() {
        guard let url = URL(string: UIApplication.openSettingsURLString) else { return }
        UIApplication.shared.open(url)
    }
    
    // MARK: - 1. Search Logic
    private func performSearch() {
        guard !searchText.isEmpty else { return }
        
        let request = MKLocalSearch.Request()
        request.naturalLanguageQuery = searchText
        // Prioritize search results near the current visible map area
        if let region = locationManager.location.map({ MKCoordinateRegion(center: $0.coordinate, span: MKCoordinateSpan(latitudeDelta: 0.3, longitudeDelta: 0.3)) }) {
            request.region = region
        }
        
        let search = MKLocalSearch(request: request)
        search.start { response, error in
            guard let response, error == nil else {
                print("Search error: \(error?.localizedDescription ?? "Unknown error")")
                return
            }
            
            let centerCoordinate = self.locationManager.location?.coordinate ?? self.defaultCoordinate
            let centerLocation = CLLocation(latitude: centerCoordinate.latitude, longitude: centerCoordinate.longitude)
            let nearbyResults = response.mapItems.filter { item in
                let itemLocation = CLLocation(latitude: item.placemark.coordinate.latitude, longitude: item.placemark.coordinate.longitude)
                return centerLocation.distance(from: itemLocation) <= 1609.34
            }

            // Update results and clear old routes
            self.searchResults = nearbyResults.isEmpty ? response.mapItems : nearbyResults
            self.route = nil
            
            // Center the map around the first search result
            if let firstItem = self.searchResults.first ?? response.mapItems.first {
                self.position = .region(MKCoordinateRegion(
                    center: firstItem.placemark.coordinate,
                    span: MKCoordinateSpan(latitudeDelta: 0.035, longitudeDelta: 0.035)
                ))
            }
        }
    }
    
    // MARK: - 2. Directions Logic
    private func fetchDirections(to destination: MKMapItem) {
        let request = MKDirections.Request()
        
        // Define Point X (Starting position). Defaults to user location.
        // Replace 'MKMapItem.forCurrentLocation()' with any custom MKMapItem to set a different Point X.
        request.source = MKMapItem.forCurrentLocation()
        request.destination = destination
        request.transportType = .automobile
        
        let directions = MKDirections(request: request)
        directions.calculate { response, error in
            guard let response, let route = response.routes.first, error == nil else {
                print("Directions error: \(error?.localizedDescription ?? "Unknown error")")
                return
            }
            
            // Save the calculated route to update the UI
            self.route = route
            
            // Dynamic Zoom: Adjust map camera bounds to fit both start and end locations
            let routeRect = route.polyline.boundingMapRect
            self.position = MapCameraPosition.rect(routeRect)
        }
    }
}

struct LocationView: View {
    let coordinate: CLLocationCoordinate2D
    let textSize: AppTextSize
    @Bindable var savedLocationStore: SavedLocationStore

    @State private var showPinNameSheet = false
    @State private var showFeatureTypeSheet = false

    var body: some View {
        VStack(spacing: 12) {
            Button {
                showPinNameSheet = true
            } label: {
                Text("Pin and Save Location")
                    .font(.headline)
                    .dynamicTypeSize(textSize.dynamicTypeSize)
                    .foregroundStyle(.white)
                    .frame(maxWidth: .infinity, minHeight: textSize.mapButtonSize)
                    .background(.blue, in: RoundedRectangle(cornerRadius: 14))
            }
            .speechAnnouncement("Pin and Save Location")

            Button {
                showFeatureTypeSheet = true
            } label: {
                Text("Mark New Accessibility Feature")
                    .font(.headline)
                    .dynamicTypeSize(textSize.dynamicTypeSize)
                    .foregroundStyle(.white)
                    .frame(maxWidth: .infinity, minHeight: textSize.mapButtonSize)
                    .background(.blue, in: RoundedRectangle(cornerRadius: 14))
            }
            .speechAnnouncement("Mark New Accessibility Feature")
        }
        .padding()
        .sheet(isPresented: $showPinNameSheet) {
            PinNameSheet(
                coordinate: coordinate,
                textSize: textSize
            ) { pinName in
                savedLocationStore.saveCustomPin(
                    name: pinName,
                    approximateAddress: "Near your location",
                    coordinate: coordinate
                )
            }
            .presentationDetents([.height(220)])
            .presentationDragIndicator(.visible)
        }
        .sheet(isPresented: $showFeatureTypeSheet) {
            FeatureTypeSelectionSheet(textSize: textSize) { featureType in
                saveAccessibleFeatureCoordinate(coordinate, featureType: featureType)
            }
            .presentationDetents([.height(280)])
            .presentationDragIndicator(.visible)
        }
    }

    private func saveAccessibleFeatureCoordinate(_ coordinate: CLLocationCoordinate2D, featureType: AccessibleFeatureType) {
        switch featureType {
        case .ramp:
            rampLocation.append(ramp(latitude: coordinate.latitude, longitude: coordinate.longitude))
        case .bench:
            benchLocation.append(bench(latitude: coordinate.latitude, longitude: coordinate.longitude))
        case .automaticDoor:
            doorLocation.append(door(latitude: coordinate.latitude, longitude: coordinate.longitude))
        case .accessibleCrosswalk:
            crosswalkLocation.append(crosswalk(latitude: coordinate.latitude, longitude: coordinate.longitude))
        case .accessibleParking:
            parkingLocation.append(parking(latitude: coordinate.latitude, longitude: coordinate.longitude))
        case .elevator:
            elevatorLocation.append(elevator(latitude: coordinate.latitude, longitude: coordinate.longitude))
        }
    }
}

