        case .notDetermined:
            "Mapscessible uses your location to center the map, show nearby places, and guide your route."
        case .authorizedAlways, .authorizedWhenInUse:
            "Location access is enabled."
        @unknown default:
            "Mapscessible uses your location to center the map, show nearby places, and guide your route."
        }
