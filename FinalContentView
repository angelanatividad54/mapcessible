enum AppTextSize: String, CaseIterable, Identifiable {
    case small
    case medium
    case large
    case extraLarge
    case extraExtraLarge
    case extraExtraExtraLarge
    case accessibilityLarge
    
    //creates the text size cases

    var id: Self { self }

    var scaleIndex: Int {
        switch self {
        case .small:
            0
        case .medium:
            1
        case .large:
            2
        case .extraLarge:
            3
        case .extraExtraLarge:
            4
        case .extraExtraExtraLarge:
            5
        case .accessibilityLarge:
            6
        }
    }
    // sets the panel to be a scale

    init(scaleIndex: Int) {
        let sizes = Self.allCases
        let clampedIndex = min(max(scaleIndex, 0), sizes.count - 1)
        self = sizes[clampedIndex]
    }

    var title: String {
        switch self {
        case .small:
            "Small"
        case .medium:
            "Medium"
        case .large:
            "Large"
        case .extraLarge:
            "Extra Large"
        case .extraExtraLarge:
            "Extra Extra Large"
        case .extraExtraExtraLarge:
            "Extra Extra Extra Large"
        case .accessibilityLarge:
            "Accessibility Large"
        }
    }

    var dynamicTypeSize: DynamicTypeSize {
        switch self {
        case .small:
            .small
        case .medium:
            .medium
        case .large:
            .large
        case .extraLarge:
            .xLarge
        case .extraExtraLarge:
            .xxLarge
        case .extraExtraExtraLarge:
            .xxxLarge
        case .accessibilityLarge:
            .accessibility1
        }
    }
    //sets the actual font size to the cases
    
    var mapButtonSize: CGFloat {
        switch self {
        case .small:
            40
        case .medium:
            44
        case .large:
            52
        case .extraLarge:
            60
        case .extraExtraLarge:
            68
        case .extraExtraExtraLarge:
            76
        case .accessibilityLarge:
            84
        }
    }
    //sets the size of the buttons to coordinate with the text size scale
    
    var mapButtonIconFont: Font {
        switch self {
        case .small:
            .body
        case .medium:
            .title3
        case .large:
            .title2
        case .extraLarge:
            .title
        case .extraExtraLarge:
            .largeTitle
        case .extraExtraExtraLarge:
            .largeTitle
        case .accessibilityLarge:
            .largeTitle
        }
    }
    //sets the size of the icons of the buttons to coordinate with the text size scale
    
    var sampleTextSize: DynamicTypeSize {
        switch self {
        case .small:
            .small
        case .medium:
            .medium
        case .large:
            .large
        case .extraLarge:
            .xLarge
        case .extraExtraLarge:
            .xxLarge
        case .extraExtraExtraLarge:
            .xxxLarge
        case .accessibilityLarge:
            .accessibility1
        }
    }
    //sets the size of the sample text to coorelate with the text size scale.
}

enum AppColorFilter: String, CaseIterable, Identifiable {
    case none
    case grayscale
    case inverted
    case invertedGrayscale
    case redBlack
    case yellowBlack
    case blueWhite
    //creates the cases

    var id: Self { self }

    var title: String {
        switch self {
        case .none:
            "None"
        case .grayscale:
            "Grayscale"
        case .inverted:
            "Inverted"
        case .invertedGrayscale:
            "Inverted Grayscale"
        case .redBlack:
            "Red / Black"
        case .yellowBlack:
            "Yellow / Black"
        case .blueWhite:
            "Blue / White"
    //sets the name that shows up on the filter panel
        }
    }
}


struct AppColorFilterModifier: ViewModifier {
    let filter: AppColorFilter

    func body(content: Content) -> some View {
        switch filter {
        case .none:
            content
        case .grayscale:
            content.saturation(0)
        case .inverted:
            content.colorInvert()
        case .invertedGrayscale:
            content
                .saturation(0)
                .colorInvert()
        case .redBlack:
            content
                .saturation(0)
                .contrast(1.8)
                .colorMultiply(.red)
        case .yellowBlack:
            content
                .saturation(0)
                .contrast(1.8)
                .colorMultiply(.yellow)
        case .blueWhite:
            content
                .saturation(0)
                .contrast(1.5)
                .colorInvert()
                .colorMultiply(.blue)
        }
    }
}
//sets the actual filter to each case

extension View {
    func appColorFilter(_ filter: AppColorFilter) -> some View {
        modifier(AppColorFilterModifier(filter: filter))
    }
}


