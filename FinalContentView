struct BenchFrequencySheet: View {
    @Environment(\.dismiss) private var dismiss
    @Binding var selection: RouteAccessibilitySelection
    @State private var numberText = ""
    var onCancel: () -> Void

    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            Text("How often would you like to see a bench?")
                .font(.headline)
            Text("Please submit a number between 0-9 miles.")
                .font(.subheadline)
                .foregroundStyle(.secondary)

            TextField("Miles", text: $numberText)
                .textFieldStyle(.roundedBorder)
                .keyboardType(.decimalPad)

            Divider()

            HStack {
                Button("Cancel") {
                    onCancel()
                    dismiss()
                }

                Spacer()

                Button("Done") {
                    let rawValue = Double(numberText) ?? 0
                    selection.benchEveryMiles = roundedQuarterMiles(rawValue)
                    dismiss()
                }
            }
        }
        .padding()
    }

    private func roundedQuarterMiles(_ value: Double) -> Double {
        let clamped = min(max(value, 0), 9)
        return (clamped * 4).rounded() / 4
    }
}

struct DirectionsSheet: View {
    @Environment(SpeechManager.self) private var speechManager
    let directions: [String]
    var endRoute: () -> Void

    var body: some View {
        NavigationStack {
            VStack(spacing: 0) {
                List(Array(directions.enumerated()), id: \.offset) { index, instruction in
                    Text(instruction)
                        .padding(.vertical, 4)
                        .listRowBackground(
                            speechManager.highlightedIdentifier == directionIdentifier(for: index)
                            ? Color.yellow.opacity(0.16)
                            : Color.clear
                        )
                }

                Button(role: .destructive) {
                    endRoute()
                } label: {
                    Text("End Route")
                        .frame(maxWidth: .infinity)
                        .padding(.vertical, 14)
                }
                .buttonStyle(.borderedProminent)
                .tint(.red)
                .padding()
            }
            .navigationTitle("Directions")
            .navigationBarTitleDisplayMode(.inline)
        }
        .onAppear {
            speakDirectionsIfNeeded()
        }
        .onChange(of: directions) { _, _ in
            speakDirectionsIfNeeded()
        }
    }

    private func directionIdentifier(for index: Int) -> String {
        "direction-\(index)"
    }

    private func speakDirectionsIfNeeded() {
        guard speechManager.isEnabled else { return }
        let segments = directions.enumerated().map { index, instruction in
            SpeechSegment(id: directionIdentifier(for: index), text: instruction)
        }
        speechManager.speak(segments: segments)
    }
}

