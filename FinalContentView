enum RouteTransportMode: String, CaseIterable, Identifiable {
    case car
    case transit
    case bike
    case walk

    var id: Self { self }

    var symbolName: String {
        switch self {
        case .car:
            "car.fill"
        case .transit:
            "tram.fill"
        case .bike:
            "bicycle"
        case .walk:
            "figure.walk"
        }
    }

    var transportType: MKDirectionsTransportType {
        switch self {
        case .car:
            .automobile
        case .transit:
            .transit
        case .bike:
            .cycling
        case .walk:
            .walking
        }
    }
}

