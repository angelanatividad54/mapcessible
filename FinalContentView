    @ViewBuilder
    private func locationRow(title: String, isDestination: Bool = false) -> some View {
        HStack {
            Image(systemName: "line.3.horizontal")
                .foregroundStyle(.secondary)
            Text(title)
                .font(.body)
            Spacer()
        }
        .padding(.vertical, 6)
    }

    private var estimatedTimeText: String {
        guard estimatedMinutes > 0 else {
            return "Undetermined."
        }

        if estimatedMinutes < 60 {
            return "\(max(1, Int(estimatedMinutes.rounded()))) min"
        }

        let hours = estimatedMinutes / 60
        if hours < 10 {
            return String(format: "%.1f hr", hours)
        }

        return "\(Int(hours.rounded())) hr"
    }

    private func rebuildRoute() async {
        let items = navigationWaypoints()

        guard !items.isEmpty else {
            await MainActor.run {
                estimatedMinutes = 0
                routeInstructions = ["No directions available."]
                routeSegments = []
                showRouteOnMap = false
            }
            return
        }

        let directRoute = await route(
            from: MKMapItem.forCurrentLocation(),
            to: destinationItem.mapItem,
            transportType: mode.transportType
        )

        var totalTravelTime: TimeInterval = 0
        var allInstructions: [String] = []
        var segments: [MKRoute] = []
        var source = MKMapItem.forCurrentLocation()

        for item in items {
            guard let route = await route(from: source, to: item.mapItem, transportType: mode.transportType) else {
                await MainActor.run {
                    estimatedMinutes = 0
                    routeInstructions = ["No route found."]
                    routeSegments = []
                    showRouteOnMap = false
                }
                return
            }

            totalTravelTime += route.expectedTravelTime
            allInstructions.append(contentsOf: route.steps.compactMap { step in
                step.instructions.isEmpty ? nil : step.instructions
            })
            segments.append(route)
            source = item.mapItem
        }

        await MainActor.run {
            if let directRoute {
                estimatedMinutes = directRoute.expectedTravelTime / 60
            } else {
                estimatedMinutes = totalTravelTime / 60
            }
            routeInstructions = allInstructions.isEmpty ? ["No route found."] : allInstructions
            routeSegments = segments
            showRouteOnMap = !segments.isEmpty
        }
    }

    private func navigationWaypoints() -> [RouteItineraryItem] {
        var items = itinerary

        if !items.contains(where: { $0.kind == .destination }) {
            items.append(destinationItem)
        }

        let accessibilityItems = accessibilityRouteItems().filter { shouldIncludeAccessibleFeature($0) }
        if let destinationIndex = items.firstIndex(where: { $0.kind == .destination }) {
            items.insert(contentsOf: accessibilityItems, at: destinationIndex)
        }

        return items
    }

    private func shouldIncludeAccessibleFeature(_ item: RouteItineraryItem) -> Bool {
        let referenceCoordinates = itinerary.compactMap { waypoint -> CLLocationCoordinate2D? in
            switch waypoint.kind {
            case .stop, .destination:
                return waypoint.mapItem.placemark.coordinate
            case .accessibility:
                return nil
            }
        }

        guard !referenceCoordinates.isEmpty else { return false }

        let featureCoordinate = item.mapItem.placemark.coordinate
        return referenceCoordinates.contains { coordinate in
            let featureLocation = CLLocation(latitude: featureCoordinate.latitude, longitude: featureCoordinate.longitude)
            let referenceLocation = CLLocation(latitude: coordinate.latitude, longitude: coordinate.longitude)
            return featureLocation.distance(from: referenceLocation) <= 1609.34
        }
    }

    private func accessibilityRouteItems() -> [RouteItineraryItem] {
        var items: [RouteItineraryItem] = []

        if accessibilitySelection.ramps {
            items.append(contentsOf: routeItems(from: rampLocation, title: "Ramp"))
        }
        if accessibilitySelection.automaticDoors {
            items.append(contentsOf: routeItems(from: doorLocation, title: "Automatic Door"))
        }
        if accessibilitySelection.parking {
            items.append(contentsOf: routeItems(from: parkingLocation, title: "Accessible Parking"))
        }
        if accessibilitySelection.elevators {
            items.append(contentsOf: routeItems(from: elevatorLocation, title: "Elevator"))
        }
        if accessibilitySelection.accessibleCrosswalks {
            items.append(contentsOf: routeItems(from: crosswalkLocation, title: "Accessible Crosswalk"))
        }
        if accessibilitySelection.benches && (mode == .walk || mode == .bike) {
            let strideCount = max(1, Int((accessibilitySelection.benchEveryMiles ?? 1).rounded()))
            let selectedBenches: [RouteItineraryItem] = benchLocation.enumerated().compactMap { (index, location) -> RouteItineraryItem? in
                guard index % strideCount == 0 else { return nil }
                return RouteItineraryItem(
                    title: "Bench",
                    mapItem: mapItem(for: location.coordinate),
                    kind: .accessibility
                )
            }
            items.append(contentsOf: selectedBenches)
        }

        return items
    }

    private func routeItems<T>(from locations: [T], title: String) -> [RouteItineraryItem] {
        locations.compactMap { element in
            let coordinate: CLLocationCoordinate2D
            switch element {
            case let value as bench:
                coordinate = value.coordinate
            case let value as ramp:
                coordinate = value.coordinate
            case let value as door:
                coordinate = value.coordinate
            case let value as parking:
                coordinate = value.coordinate
            case let value as elevator:
                coordinate = value.coordinate
            case let value as crosswalk:
                coordinate = value.coordinate
            default:
                return nil
            }

            return RouteItineraryItem(
                title: title,
                mapItem: mapItem(for: coordinate),
                kind: .accessibility
            )
        }
    }

    private func mapItem(for coordinate: CLLocationCoordinate2D) -> MKMapItem {
        MKMapItem(placemark: MKPlacemark(coordinate: coordinate))
    }

    private func route(from source: MKMapItem, to destination: MKMapItem, transportType: MKDirectionsTransportType) async -> MKRoute? {
        await withCheckedContinuation { continuation in
            let request = MKDirections.Request()
            request.source = source
            request.destination = destination
            request.transportType = transportType
            request.requestsAlternateRoutes = true

            MKDirections(request: request).calculate { response, _ in
                continuation.resume(returning: response?.routes.first)
            }
        }
    }
}

